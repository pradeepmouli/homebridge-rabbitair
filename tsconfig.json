{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
		],
		"rootDir": "src",
		"module": "node18",
		"moduleResolution": "node16",
		"strict": true,
		"declaration": true,
		"outDir": "dist",
		"sourceMap": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strictNullChecks": false,
		"skipLibCheck": true,
		"downlevelIteration": true,
		"types": [
			"node"
		]
	},
	"include": [
		"src"
	]
}