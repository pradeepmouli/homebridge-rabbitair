{
	"trailingComma": "none",
	"tabWidth": 2,
	"semi": true,
	"singleQuote": true,
	"useTabs": true,
	"printWidth": 80,
	"bracketSpacing": true,
	"arrowParens": "always",
	"endOfLine": "lf",
	"quoteProps": "as-needed",
	"proseWrap": "preserve",
	"htmlWhitespaceSensitivity": "ignore",
	"formatOnSave": true,
	"embeddedLanguageFormatting": "auto"
}