{
  "name": "homebridge-rabbitair",
  "displayName": "Homebridge RabbitAir",
  "type": "module",
  "version": "1.0.5",
  "private": false,
  "description": "Homebridge plugin for RabbitAir air purifiers",
  "author": "Pradeep Mouli",
  "license": "Apache-2.0",
  "homepage": "https://github.com/pradeepmouli/homebridge-rabbitair#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/homebridge-rabbitair.git"
  },
  "bugs": {
    "url": "https://github.com/pradeepmouli/homebridge-rabbitair/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "rabbitair",
    "air-purifier"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "mocha --require tsx 'test/**/*.test.ts'",
    "test:unit": "tsx ./node_modules/.bin/mocha 'test/unit/**/*.test.ts'",
    "test:integration": "tsx ./node_modules/.bin/mocha 'test/integration/**/*.test.ts'",
    "test:e2e": "tsx ./node_modules/.bin/mocha 'test/e2e/**/*.test.ts' --timeout 10000",
    "test:coverage": "c8 npm run test",
    "test:watch": "npm run test -- --watch",
    "version": "changelog --release --commit",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "@types/chai-as-promised": "^8.0.2",
    "crypto-js": "^4.2.0",
    "hap-fluent": "^0.3.0",
    "hap-nodejs": "^1.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/crypto-js": "^4.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.1",
    "@types/sinon": "^17.0.4",
    "@types/sinon-chai": "^4.0.0",
    "c8": "^10.1.3",
    "chai": "^6.2.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^9.38.0",
    "homebridge": "^1.11.0",
    "jiti": "^2.6.1",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1",
    "ts-morph": "^26.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "type-fest": "^4.41.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
