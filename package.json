{
  "name": "homebridge-rabbitair",
  "displayName": "Homebridge RabbitAir",
  "version": "1.0.6",
  "private": false,
  "description": "Homebridge plugin for RabbitAir air purifiers",
  "keywords": [
    "air-purifier",
    "homebridge-plugin",
    "rabbitair"
  ],
  "homepage": "https://github.com/pradeepmouli/homebridge-rabbitair#readme",
  "bugs": {
    "url": "https://github.com/pradeepmouli/homebridge-rabbitair/issues"
  },
  "license": "Apache-2.0",
  "author": "Pradeep Mouli",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/homebridge-rabbitair.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsgo",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "version": "changelog --release --commit",
    "prepublishOnly": "npm run clean && npm run lint && npm run test && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish",
    "prepare": "simple-git-hooks",
    "type-check": "tsgo --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@changesets/cli": "^2.29.8",
    "crypto-js": "^4.2.0",
    "hap-fluent": "^0.4.0",
    "hap-nodejs": "^1.2.0",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.4",
    "@pmouli/hap-test": "^0.4.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^25.0.9",
    "@types/sinon": "^21.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260219.1",
    "@vitest/coverage-istanbul": "^4.0.17",
    "homebridge": "^1.11.1",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.35.0",
    "rimraf": "^6.1.2",
    "simple-git-hooks": "^2.13.1",
    "sinon": "^21.0.1",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "type-fest": "^5.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.17"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm run type-check"
  },
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0-beta.0",
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.6.2"
}
