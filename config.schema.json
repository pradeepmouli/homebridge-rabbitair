{
  "pluginAlias": "RabbitAir",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "RabbitAir"
      },
      "devices": {
        "title": "Devices",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Device Name",
              "type": "string",
              "required": true
            },
            "host": {
              "title": "Host/IP Address",
              "type": "string",
              "required": true,
              "description": "IP address or hostname of the device (e.g., 192.168.1.100 or device.local)"
            },
            "token": {
              "title": "Access Token",
              "type": "string",
              "required": true,
              "description": "32-character access token from the RabbitAir app"
            },
            "port": {
              "title": "Port",
              "type": "integer",
              "default": 9009,
              "description": "UDP port for communication (default: 9009)"
            }
          }
        }
      }
    }
  }
}
